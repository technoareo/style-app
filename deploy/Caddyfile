# Build 016/017 transport hardening. Validated with official Caddy 2.11.7 and
# run in local loopback TLS replicas (untrusted internal certificate; app 20 s
# and 60 s settings). NOT run in Docker, on Linux, on a public domain, behind a
# real certificate, or at an app setting of 120 s. See docs/DEPLOYMENT.md
# "Proxy transport behaviour" for exact scope and gates.
{
  servers {
    # HTTP/1.1 only, for now. The 408-then-close behaviour below was measured on
    # HTTP/1.1 only; with HTTP/2 the same stalled upload ended with a GOAWAY after
    # the 408 and that was never resolved. This also drops HTTP/3 (compose.yaml
    # publishes TCP 443 only, so HTTP/3 was not reachable anyway). Remove this
    # line only after a stalled-upload probe passes over h2 on the target.
    protocols h1
    timeouts {
      # Slow-header (slowloris) bound.
      read_header 10s
      # Hard limit on the WHOLE request body. It must stay above the app's own
      # STYLE_BODY_READ_TIMEOUT_MS so the app answers first with its JSON 408.
      # Under Compose the proxy start command derives
      # STYLE_PROXY_BODY_READ_TIMEOUT_S = ceil(app ms / 1000) + 2 from the same
      # project variable the app uses (see compose.yaml), so there is nothing to
      # pair by hand. There is deliberately NO default here: outside Compose the
      # variable must be set (22 pairs with the app default of 20 s), and an
      # unset one makes Caddy refuse to start instead of guessing a cap.
      read_body {$STYLE_PROXY_BODY_READ_TIMEOUT_S}s
      # Caddy's own default for the body STALL timer, read_body_idle, is 1 m.
      # With an app deadline of 60 s or more that timer fires at about the same
      # moment as the app's (or before it, at 120 s), and a measured 60 s run
      # left a fully stalled upload without any reply for 70 s. Set it to the
      # same value as the total cap so it can never fire before the total cap,
      # and the app's own 408 (cap minus 2 s) is always first. With this line a
      # 60 s / 62 s local TLS run returned the app's 408 for a stalled and a
      # trickled upload; 120 s has not been run.
      read_body_idle {$STYLE_PROXY_BODY_READ_TIMEOUT_S}s
      # Not set on purpose: `write`/`write_idle` (the answer stream and photo
      # downloads would be cut) and `idle` (Caddy default 5 m).
    }
  }
}

{$STYLE_DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 10MB
  }
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
  # Operator-only upload counters: never served through the public proxy.
  # They stay reachable inside the app container; see docs/DEPLOYMENT.md.
  @upload_counters path /api/health/uploads /api/health/uploads/*
  handle @upload_counters {
    respond 404
  }
  handle {
    reverse_proxy app:3000 {
      # When the app answers an error (the 408 for a stalled upload, 401, 413,
      # 429, 5xx) before it has read the whole request body, close the client
      # connection after the response. Without this the shipped rules left a
      # stalled upload unanswered past 35 s on HTTP/1.1. The response itself
      # (status, headers, JSON body) is copied unchanged by `copy_response`
      # alone. Do NOT add `copy_response_headers`: copy_response already runs
      # Caddy's normal response finalisation, which copies the upstream headers
      # (and drops hop-by-hop ones), and an explicit header copy on top of it
      # DUPLICATED them (measured: `Cache-Control: private, no-store,
      # private, no-store`). `header Connection close` is set first so it
      # survives. tests/proxyConfig.test.ts rejects copy_response_headers.
      @upstream_error status 4xx 5xx
      handle_response @upstream_error {
        header Connection close
        copy_response
      }
    }
  }
}
